---
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy-dark text-warm-gray">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      <!-- Brand -->
      <div class="flex flex-col items-center text-center">
        <img
          src="/images/logo-circle-white.png"
          alt="Raedwulf Productions"
          class="h-16 w-auto mb-3"
          width="64"
          height="64"
        />
        <p class="text-sm text-slate-light leading-relaxed">
          Custom furniture, CNC design &amp; programming, and design-build solutions.
        </p>
      </div>

      <!-- Navigation -->
      <div class="flex flex-col items-center text-center">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-warm-white mb-3">Navigation</h4>
        <ul class="space-y-2">
          <li><a href="/work" class="text-sm text-slate-light hover:text-brown-light">Work</a></li>
          <li><a href="/about" class="text-sm text-slate-light hover:text-brown-light">About</a></li>
          <li><a href="/contact" class="text-sm text-slate-light hover:text-brown-light">Contact</a></li>
        </ul>
      </div>

      <!-- Connect -->
      <div class="flex flex-col items-center text-center">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-warm-white mb-3">Connect</h4>
        <ul class="space-y-2">
          <li><a href="/contact" class="text-sm text-slate-light hover:text-brown-light">Get in Touch</a></li>
          <li><a href="https://www.linkedin.com/in/benmuratet/" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-light hover:text-brown-light">LinkedIn</a></li>
          <li><a href="https://raedwulfcraftco.etsy.com" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-light hover:text-brown-light">Raedwulf Craft Co</a></li>
        </ul>
      </div>

    </div>

    <div class="mt-10 pt-6 border-t border-navy-light text-center text-sm text-slate-light">
      &copy; {currentYear} Raedwulf Productions. All rights reserved.
    </div>
  </div>
</footer>
