---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch for custom fabrication, production consulting, or partnership opportunities.">
  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="mb-4">Get in Touch</h1>
      <p class="text-xl text-slate leading-relaxed mb-12">
        Have a project, a production challenge, or a partnership idea? I'd like to hear about it. Fill out the form below or reach out directly.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <!-- Form -->
        <div class="md:col-span-2">
          <form name="contact" method="POST" data-netlify="true" class="space-y-6">
            <input type="hidden" name="form-name" value="contact" />

            <div>
              <label for="name" class="block text-sm font-semibold text-navy mb-2">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border border-warm-gray rounded bg-white text-navy focus:outline-none focus:border-brown focus:ring-1 focus:ring-brown"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-navy mb-2">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-warm-gray rounded bg-white text-navy focus:outline-none focus:border-brown focus:ring-1 focus:ring-brown"
              />
            </div>

            <div>
              <label for="type" class="block text-sm font-semibold text-navy mb-2">I'm interested in...</label>
              <select
                id="type"
                name="type"
                class="w-full px-4 py-3 border border-warm-gray rounded bg-white text-navy focus:outline-none focus:border-brown focus:ring-1 focus:ring-brown"
              >
                <option value="custom-build">Custom Furniture / Fabrication</option>
                <option value="consulting">Production Consulting</option>
                <option value="cnc">CNC Workflow Design</option>
                <option value="partnership">Partnership / Equity Opportunity</option>
                <option value="other">Something Else</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-navy mb-2">Tell me about the project</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 border border-warm-gray rounded bg-white text-navy focus:outline-none focus:border-brown focus:ring-1 focus:ring-brown resize-y"
                placeholder="What are you building? What constraints are you working with?"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-brown hover:bg-brown-light text-warm-white font-semibold px-8 py-3 rounded transition-colors duration-200 cursor-pointer"
            >
              Send Message
            </button>
          </form>
        </div>

        <!-- Contact Info -->
        <div class="space-y-8">
          <div>
            <h3 class="text-lg font-bold mb-2">Direct</h3>
            <p class="text-slate text-sm">
              <a href="mailto:ben@raedwulfproductions.com">ben@raedwulfproductions.com</a>
            </p>
          </div>

          <div>
            <h3 class="text-lg font-bold mb-2">LinkedIn</h3>
            <p class="text-slate text-sm">
              <a href="https://www.linkedin.com/in/benmuratet/" target="_blank" rel="noopener noreferrer">linkedin.com/in/benmuratet</a>
            </p>
          </div>

          <div>
            <h3 class="text-lg font-bold mb-2">Shop Products</h3>
            <p class="text-slate text-sm">
              <a href="https://raedwulfcraftco.etsy.com" target="_blank" rel="noopener noreferrer">Raedwulf Craft Co on Etsy</a>
            </p>
          </div>

          <div>
            <h3 class="text-lg font-bold mb-2">Location</h3>
            <p class="text-slate text-sm">Atlanta, GA</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
