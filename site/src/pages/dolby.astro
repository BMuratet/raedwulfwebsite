<style is:global>
  #kw-canvas { image-rendering: auto; }
</style>

<script is:inline src="/js/wave-engine.js"></script>
<script is:inline>
  (function () {
    var state = { pattern: 'flow', style: 'smooth' };
    var $ = function (id) { return document.getElementById(id); };

    function profile() {
      return window.WaveEngine.deriveProfile({
        name: $('kw-name').value || 'Anonymous',
        hebrewName: '', motherName: '',
        month: Number($('kw-month').value) || 1,
        day: Number($('kw-day').value) || 1,
        year: Number($('kw-year').value) || 2000
      });
    }

    function paint() {
      if (!window.WaveEngine) return;
      var cv = $('kw-canvas');
      if (!cv) return;
      var N = 360;
      cv.width = N; cv.height = N;
      var prof = profile();
      var P = prof.params;
      P.pattern = state.pattern;
      P.style = state.style;
      var field = window.WaveEngine.renderHeightField(P, N, N, 1);
      var ctx = cv.getContext('2d');
      var img = ctx.createImageData(N, N);
      var lo = [30, 17, 6], hi = [226, 165, 108];
      for (var j = 0; j < N; j++) {
        for (var i = 0; i < N; i++) {
          var k = j * N + i;
          var h = field[k];
          var hx = field[j * N + Math.min(N - 1, i + 1)] - h;
          var hy = field[Math.min(N - 1, j + 1) * N + i] - h;
          var t = h + 5.5 * (hx * 0.8 + hy * 0.6);
          t = t < 0 ? 0 : t > 1 ? 1 : t;
          var g = 4 * k;
          img.data[g]     = lo[0] + (hi[0] - lo[0]) * t;
          img.data[g + 1] = lo[1] + (hi[1] - lo[1]) * t;
          img.data[g + 2] = lo[2] + (hi[2] - lo[2]) * t;
          img.data[g + 3] = 255;
        }
      }
      ctx.putImageData(img, 0, 0);

      var d = prof.derivation || {};
      var set = function (id, v) { var el = $(id); if (el) el.textContent = (v === undefined || v === null) ? '\u2014' : v; };
      set('kw-gematria', d.gematriaTotal);
      set('kw-lifepath', d.lifePath);
      set('kw-dayletter', d.dayLetter);
      set('kw-daylettername', d.dayLetterName);
      set('kw-zodiac', d.zodiacSign);
      set('kw-planet', d.rulingPlanet);
      set('kw-sefirah', d.sefirah);
      set('kw-pillar', d.pillar);
      var ch = $('kw-character'); if (ch) ch.textContent = d.planetCharacter || '';
    }

    function syncButtons() {
      Array.prototype.forEach.call(document.querySelectorAll('.kw-pat'), function (b) {
        var on = b.dataset.pattern === state.pattern;
        b.style.background = on ? '#1B2A4A' : 'transparent';
        b.style.color = on ? '#FAF8F5' : '#C9CFDB';
      });
      Array.prototype.forEach.call(document.querySelectorAll('.kw-sty'), function (b) {
        var on = b.dataset.style === state.style;
        b.style.background = on ? '#8B6914' : 'transparent';
        b.style.color = on ? '#FAF8F5' : '#C9CFDB';
      });
    }

    function init() {
      ['kw-name', 'kw-month', 'kw-day', 'kw-year'].forEach(function (id) {
        var el = $(id); if (el) el.addEventListener('input', paint);
      });
      Array.prototype.forEach.call(document.querySelectorAll('.kw-pat'), function (b) {
        b.addEventListener('click', function () { state.pattern = b.dataset.pattern; syncButtons(); paint(); });
      });
      Array.prototype.forEach.call(document.querySelectorAll('.kw-sty'), function (b) {
        b.addEventListener('click', function () { state.style = b.dataset.style; syncButtons(); paint(); });
      });
      syncButtons();
      paint();
    }

    var tries = 0;
    (function wait() {
      if (window.WaveEngine) { init(); return; }
      if (++tries > 100) return;
      setTimeout(wait, 60);
    })();
  })();
</script>
