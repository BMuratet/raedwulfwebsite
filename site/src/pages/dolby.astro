---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const ORDER = [
  'opencraft-estimating-engine',
  'kabbalah-wave-panels',
  'theoakhome',
  'shop-floor-board',
];

const work = await getCollection('work', ({ id }) => ORDER.includes(id));
work.sort((a, b) => ORDER.indexOf(a.id) - ORDER.indexOf(b.id));

const cases = await Promise.all(
  work.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---

<BaseLayout
  title="Portfolio"
  description="Four case studies: an estimating engine running two businesses, a generative CNC system, a solo brand build, and a shop-floor ops tool."
  noindex={true}
>
  <section class="intro">
    <p class="intro-eyebrow">Selected Work</p>
    <h1 class="intro-title">"I didn't know I could make that."</h1>
    <p class="intro-body">
      That's the reaction I build toward — whether it's a piece of furniture, a piece of software, or a generative CNC engine that turns someone's birthdate into a physical object.
    </p>
    <p class="intro-body">
      Every project here existed because somewhere between an idea and a finished thing, there was a gap nobody was closing — between a screen and a shop floor, a spreadsheet and a real number, a name and a physical object. My job was never one role. It was closing that gap: inventing something that closed it, then judging honestly what it actually proved — and what it didn't yet.
    </p>
  </section>

  {cases.map(({ entry, Content }, i) => {
    const { data } = entry;
    return (
      <article class="detail-page">
        <span class="ghost-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

        <header class="detail-header">
          <div class="detail-cat">{data.category}&ensp;·&ensp;{data.duration}</div>
          <h2 class="detail-title">{data.title}</h2>
          <p class="detail-subtitle">{data.subtitle}</p>
        </header>

        <div class="detail-pullquote">
          <p>"{data.constraint}"</p>
        </div>

        <div class="detail-body">
          <div class="detail-photo-col">
            {data.heroImage ? (
              <img src={data.heroImage} alt={data.title} class="detail-hero" style={data.heroAspectRatio ? `aspect-ratio: ${data.heroAspectRatio}` : undefined} />
            ) : (
              <div class="detail-hero detail-hero-placeholder"></div>
            )}
          </div>

          <div class="detail-brief-col">
            <div class="brief-block">
              <div class="brief-label">The Problem</div>
              <div class="brief-val">{data.constraint}</div>
            </div>
            <div class="brief-block">
              <div class="brief-label">The Outcome</div>
              <div class="brief-val">{data.outcome}</div>
            </div>
            <div class="brief-block">
              <div class="brief-label">Role</div>
              <div class="brief-val">{data.role}</div>
            </div>
          </div>
        </div>

        {data.processImages && data.processImages.length > 0 && (
          <div class="detail-process">
            <div class="process-section-label">Process</div>
            <div class="process-grid">
              {data.processImages.slice(0, 4).map((img) => (
                <div class="process-cell">
                  <img src={img.src} alt={img.alt} loading="lazy" class="process-img" />
                  <div class="process-cell-label">{img.label}</div>
                  {img.description && <div class="process-cell-desc">{img.description}</div>}
                </div>
              ))}
            </div>
          </div>
        )}

        <div class="detail-narrative">
          <div class="prose prose-lg prose-slate">
            <Content />
          </div>

          {data.valueCreated.length > 0 && (
            <div class="value-list">
              <div class="value-label">Value Created</div>
              <ul>
                {data.valueCreated.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          )}
        </div>

        <div class="detail-footer">
          {data.skillsDemonstrated.length > 0 && (
            <div class="skills-wrap">
              <div class="skills-label">Skills Demonstrated</div>
              <div class="skills-list">
                {data.skillsDemonstrated.map((skill) => <span class="skill-tag">{skill}</span>)}
              </div>
            </div>
          )}
        </div>
      </article>
    );
  })}

  <section class="intro">
    <p class="intro-eyebrow">Why This Page Exists</p>
    <h2 class="intro-title">Invent. Prototype. Judge. Repeat.</h2>
    <p class="intro-body">
      Four different problems, four different mediums — the same job every time. That's the work I want to keep doing.
    </p>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 700px;
    margin: 3rem auto 1rem;
    padding: 0 2rem;
    text-align: center;
  }

  .intro-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8B6914;
    margin: 0 0 0.75rem;
  }

  .intro-title {
    font-size: 2rem;
    font-weight: 800;
    color: #1B2A4A;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1.25rem;
  }

  @media (min-width: 640px) {
    .intro-title { font-size: 2.5rem; }
  }

  .intro-body {
    font-size: 0.95rem;
    color: #4A5568;
    line-height: 1.7;
    margin: 0 0 1rem;
  }

  /* ---- Main article wrapper ---- */
  .detail-page {
    background: #FAF8F5;
    max-width: 900px;
    margin: 2.5rem auto;
    border-radius: 10px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    overflow: hidden;
    position: relative;
  }

  @media (max-width: 960px) {
    .detail-page {
      margin: 1.5rem 0;
      border-radius: 0;
      box-shadow: none;
      border-top: 1px solid #E8E4DF;
      border-bottom: 1px solid #E8E4DF;
    }
  }

  .ghost-num {
    position: absolute;
    top: 1.25rem;
    right: 1.75rem;
    font-size: 6rem;
    font-weight: 800;
    color: rgba(27,42,74,0.055);
    line-height: 1;
    letter-spacing: -0.04em;
    user-select: none;
    pointer-events: none;
  }

  .detail-header {
    padding: 2rem 2rem 0;
    position: relative;
  }

  .detail-cat {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8B6914;
    margin-bottom: 0.5rem;
  }

  .detail-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #1B2A4A;
    letter-spacing: -0.03em;
    line-height: 1.1;
    max-width: 540px;
    margin: 0 0 0.35rem;
  }

  .detail-subtitle {
    font-size: 0.9rem;
    color: #718096;
    font-weight: 400;
    margin: 0;
  }

  @media (min-width: 640px) {
    .detail-title { font-size: 2.1rem; }
  }

  .detail-pullquote {
    margin: 1.25rem 2rem 0;
    padding: 0.9rem 1.25rem;
    border-left: 3px solid #8B6914;
    background: rgba(139,105,20,0.05);
    border-radius: 0 4px 4px 0;
  }

  .detail-pullquote p {
    font-size: 0.88rem;
    color: #4A5568;
    font-style: italic;
    line-height: 1.65;
    margin: 0;
  }

  .detail-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    padding: 1.5rem 2rem;
  }

  @media (min-width: 640px) {
    .detail-body {
      grid-template-columns: 1.4fr 1fr;
      gap: 1.5rem;
      align-items: start;
    }
  }

  .detail-hero {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 6px;
    display: block;
    background: #E8E4DF;
  }

  .detail-hero-placeholder {
    background: linear-gradient(135deg, #1B2A4A 0%, #2A3F6B 60%, #4A5568 100%);
  }

  .detail-brief-col {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding-top: 1rem;
  }

  @media (min-width: 640px) {
    .detail-brief-col {
      padding-top: 0;
      border-left: 1px solid #E8E4DF;
      padding-left: 1.5rem;
    }
  }

  .brief-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8B6914;
    margin-bottom: 0.3rem;
  }

  .brief-val {
    font-size: 0.83rem;
    color: #4A5568;
    line-height: 1.65;
  }

  .detail-process {
    margin: 0 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid #E8E4DF;
  }

  .process-section-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #718096;
    margin-bottom: 0.9rem;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .process-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.75rem;
    }
  }

  .process-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 5px;
    display: block;
    background: #E8E4DF;
  }

  .process-cell-label {
    font-size: 0.65rem;
    font-weight: 600;
    color: #718096;
    margin-top: 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .process-cell-desc {
    font-size: 0.72rem;
    color: #718096;
    line-height: 1.45;
    margin-top: 0.2rem;
  }

  .detail-narrative {
    margin: 0 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid #E8E4DF;
  }

  .value-list {
    margin-top: 1.5rem;
    padding-left: 1rem;
    border-left: 2px solid #8B6914;
  }

  .value-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8B6914;
    margin-bottom: 0.5rem;
  }

  .value-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .value-list li {
    font-size: 0.82rem;
    color: #4A5568;
    line-height: 1.55;
    padding-left: 1rem;
    position: relative;
  }

  .value-list li::before {
    content: "›";
    position: absolute;
    left: 0;
    color: #8B6914;
  }

  .detail-footer {
    margin: 0 2rem;
    padding: 1.25rem 0 2rem;
    border-top: 1px solid #E8E4DF;
  }

  .skills-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #718096;
    margin-bottom: 0.5rem;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skill-tag {
    font-size: 0.72rem;
    font-weight: 500;
    color: #1B2A4A;
    background: #E8E4DF;
    padding: 0.22rem 0.7rem;
    border-radius: 99px;
  }
</style>
