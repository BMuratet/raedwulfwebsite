    <section style="padding:5.5rem 2rem 5rem;background:#FAF8F5">
      <div style="max-width:1180px;margin:0 auto">

        <div style="display:flex;align-items:flex-start;gap:2rem;margin-bottom:2.6rem;flex-wrap:wrap">
          <div style="font-size:5.5rem;font-weight:800;letter-spacing:-0.05em;line-height:0.8;color:rgba(27,42,74,0.11);flex:none">03</div>
          <div style="flex:1;min-width:min(100%,26rem)">
            <div style="font-size:0.62rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#8B6914;margin-bottom:0.7rem">Systems &middot; Solo build, concept to live launch</div>
            <h2 style="font-size:clamp(1.9rem,3.6vw,2.7rem);font-weight:800;letter-spacing:-0.038em;line-height:1.05;margin:0 0 0.6rem;color:#1B2A4A;max-width:26ch">theoakhome.com: brand site, one person</h2>
